---
import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';

import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="theme-color" content="#050508" />

    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <Analytics />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://skillcheckgame.com/" />
    <meta property="og:title" content="Skill Check - Daily Trivia Card Game" />
    <meta
      property="og:description"
      content="A daily trivia card game for gaming enthusiasts. Collect cartridges, discover synergies, and compete on the global leaderboard. New challenge every day."
    />
    <meta property="og:image" content="https://skillcheckgame.com/images/og-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Skill Check" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://skillcheckgame.com/" />
    <meta property="twitter:title" content="Skill Check - Daily Trivia Card Game" />
    <meta
      property="twitter:description"
      content="A daily trivia card game for gaming enthusiasts. New challenge every day. Free to play."
    />
    <meta property="twitter:image" content="https://skillcheckgame.com/images/og-card.png" />

    <meta name="apple-mobile-web-app-title" content="Skill Check" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="mobile-web-app-capable" content="yes" />

    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <slot />

    <BasicScripts />

    <!-- Cookie Consent Banner -->
    <div
      id="cookie-banner"
      style="display: none; position: fixed; bottom: 0; left: 0; right: 0; background: #151518; border-top: 1px solid #2a2a35; padding: 1rem 1.5rem; z-index: 99999; font-family: 'Outfit', sans-serif; font-size: 0.85rem; color: #888899; text-align: center;"
    >
      This site uses cookies for ads and analytics.
      <a href="/privacy" style="color: #00e5ff; text-decoration: underline; margin: 0 0.25rem;">Privacy Policy</a>
      <button
        id="cookie-accept"
        style="margin-left: 1rem; padding: 0.5rem 1.25rem; background: #00e5ff; color: #050508; border: none; border-radius: 0.5rem; font-weight: 700; font-size: 0.85rem; cursor: pointer; font-family: 'Outfit', sans-serif;"
        >OK</button
      >
    </div>

    <script is:inline>
      (function () {
        if (!localStorage.getItem('cookie_consent')) {
          const banner = document.getElementById('cookie-banner');
          if (banner) banner.style.display = 'block';
        }
        const btn = document.getElementById('cookie-accept');
        if (btn) {
          btn.addEventListener('click', function () {
            localStorage.setItem('cookie_consent', '1');
            const banner = document.getElementById('cookie-banner');
            if (banner) banner.style.display = 'none';
          });
        }
      })();
    </script>
  </body>
</html>
