<script>
  (function () {
    const backBtn = document.getElementById('back-to-game');
    const closeHint = document.getElementById('close-hint');

    const wasOpenedByGame = !!window.opener;
    const isInIframe = window.parent !== window;
    const hasHistory = window.history.length > 1;

    if (backBtn) {
      backBtn.addEventListener('click', function (e) {
        e.preventDefault();

        if (wasOpenedByGame) {
          // Opened from the game — close the tab
          window.close();
          // If window.close() was blocked by the browser, show hint
          setTimeout(function () {
            if (closeHint) closeHint.style.display = 'block';
            backBtn.textContent = 'Close this tab manually';
          }, 500);
        } else if (isInIframe) {
          window.parent.postMessage({ type: 'CLOSE_LEGAL' }, '*');
        } else if (hasHistory) {
          // Came from another page on the site — go back
          window.history.back();
        } else {
          // Direct visit with no history — go to homepage
          window.location.href = '/';
        }
      });
    }

    // Keep footer nav links in same tab when opened from game
    if (wasOpenedByGame || isInIframe) {
      const footerLinks = document.querySelectorAll('.footer-nav a');
      for (let i = 0; i < footerLinks.length; i++) {
        const anchor = footerLinks[i] as HTMLAnchorElement;
        if (anchor.href && !anchor.href.startsWith('mailto:')) {
          anchor.setAttribute('target', '_self');
        }
      }
    }
  })();
</script>
