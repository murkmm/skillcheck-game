---
import LegalLayout from '~/layouts/LegalLayout.astro';
---

<LegalLayout title="Page Not Found">
  <div style="text-align: center; padding: 3rem 0;">
    <p
      style="font-family: 'JetBrains Mono', monospace; font-size: 4rem; font-weight: 900; color: #ffcc00; margin-bottom: 1rem;"
    >
      404
    </p>
    <p style="font-size: 1.1rem; color: #888899; margin-bottom: 2rem;">
      This page doesn't exist. Maybe it was a mystery card.
    </p>
    <a
      href="/"
      style="display: inline-block; padding: 0.75rem 2rem; background: #00e5ff; color: #050508; border-radius: 0.5rem; text-decoration: none; font-weight: 700; font-family: 'JetBrains Mono', monospace;"
      >BACK TO GAME</a
    >
  </div>
</LegalLayout>
