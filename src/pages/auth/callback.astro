---
// OAuth callback page — receives Supabase session tokens in the URL hash
// after Google/Discord OAuth flow, relays them to the game iframe in the
// opener window, then closes itself.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Signing you in…</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
      body {
        background: #050508;
        color: #ffffff;
        font-family: system-ui, sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        text-align: center;
        padding: 1rem;
      }
      .spinner {
        width: 40px;
        height: 40px;
        border: 3px solid #2a2a35;
        border-top-color: #00e5ff;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin-bottom: 1.5rem;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
      h1 {
        font-size: 1.2rem;
        font-weight: 600;
        margin: 0 0 0.5rem;
      }
      p {
        color: #888899;
        font-size: 0.9rem;
        margin: 0;
        max-width: 400px;
      }
      .error {
        color: #ff4466;
      }
      button {
        margin-top: 1.5rem;
        padding: 0.75rem 1.5rem;
        background: #00e5ff;
        color: #050508;
        border: none;
        border-radius: 0.5rem;
        font-weight: 700;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <div class="spinner" id="spinner"></div>
    <h1 id="status-title">Signing you in…</h1>
    <p id="status-msg">Just a moment, returning you to the game.</p>
    <button id="return-btn" style="display: none;">Return to game</button>

    <script is:inline>
      (function () {
        const statusTitle = document.getElementById('status-title');
        const statusMsg = document.getElementById('status-msg');
        const spinner = document.getElementById('spinner');
        const returnBtn = document.getElementById('return-btn');

        function showError(msg) {
          if (spinner) spinner.style.display = 'none';
          if (statusTitle) {
            statusTitle.textContent = 'Sign-in failed';
            statusTitle.classList.add('error');
          }
          if (statusMsg) statusMsg.textContent = msg;
          if (returnBtn) {
            returnBtn.style.display = 'inline-block';
            returnBtn.onclick = function () {
              window.location.href = 'https://skillcheckgame.com/';
            };
          }
        }

        // Supabase returns tokens in the URL hash fragment
        // Format: #access_token=...&refresh_token=...&expires_in=...&token_type=bearer
        const hash = window.location.hash.substring(1);
        if (!hash) {
          showError('No sign-in data received. Please try again.');
          return;
        }

        const params = new URLSearchParams(hash);
        const accessToken = params.get('access_token');
        const refreshToken = params.get('refresh_token');
        const errorDescription = params.get('error_description');

        if (errorDescription) {
          showError(decodeURIComponent(errorDescription.replace(/\+/g, ' ')));
          return;
        }

        if (!accessToken || !refreshToken) {
          showError('Sign-in tokens missing. Please try again.');
          return;
        }

        const payload = {
          type: 'OAUTH_SUCCESS',
          access_token: accessToken,
          refresh_token: refreshToken,
        };

        // Opener is the game tab (or parent, if redirect happened in parent)
        let delivered = false;

        if (window.opener && !window.opener.closed) {
          try {
            window.opener.postMessage(payload, 'https://skillcheckgame.com');
            delivered = true;
          } catch (err) {
            console.error('[CALLBACK] postMessage to opener failed:', err);
          }
        }

        if (delivered) {
          if (statusTitle) statusTitle.textContent = 'Signed in!';
          if (statusMsg) statusMsg.textContent = 'Closing this tab…';
          // Give the opener a moment to receive the message
          setTimeout(function () {
            window.close();
            // Fallback if window.close fails (some browsers block it)
            setTimeout(function () {
              window.location.href = 'https://skillcheckgame.com/';
            }, 500);
          }, 400);
        } else {
          // No opener — fall back to redirecting this tab home with tokens in sessionStorage
          try {
            sessionStorage.setItem('sc_oauth_tokens', JSON.stringify(payload));
          } catch {
            /* sessionStorage unavailable (incognito etc.) — fall through to redirect */
          }
          window.location.href = 'https://skillcheckgame.com/?oauth=pending';
        }
      })();
    </script>
  </body>
</html>
