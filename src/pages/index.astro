<script>
  document.addEventListener('astro:page-load', () => {
    if (!document.getElementById('game-iframe')) return;
    const controller = new AbortController();
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
    document.querySelectorAll<HTMLAnchorElement>('[data-funnel]').forEach((link) => {
      if (link.dataset.tracked) return;
      link.dataset.tracked = 'true';
      link.addEventListener('click', () => {
        const eventName = link.dataset.funnel;
        const analytics = window as unknown as { gtag?: (command: string, name: string) => void };
        if (eventName) analytics.gtag?.('event', eventName);
      });
    });
    // ===== FULLSCREEN TOGGLE =====
    const fsBtn = document.getElementById('fullscreen-btn') as HTMLButtonElement | null;
    const container = document.getElementById('game-container');
    const column = container ? container.parentElement : null;
    const fsText = document.getElementById('fullscreen-text') as HTMLElement | null;
    const iconMax = document.getElementById('icon-max');

    if (fsBtn && column) {
      fsBtn.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          column.requestFullscreen().catch((err: Error) => {
            console.error(`Error attempting to enable full-screen mode: ${err.message}`);
          });
        } else {
          document.exitFullscreen();
        }
      });

      document.addEventListener(
        'fullscreenchange',
        () => {
          const gameWrapper = document.getElementById('game-container');
          const frameContainer = gameWrapper?.querySelector('.game-frame-container') as HTMLElement | null;

          if (fsText && iconMax && fsBtn) {
            if (document.fullscreenElement) {
              // Compact icon-only button
              fsText.style.display = 'none';
              fsBtn.style.position = 'fixed';
              fsBtn.style.right = '0.5rem';
              fsBtn.style.bottom = '0.5rem';
              fsBtn.style.zIndex = '9999';
              fsBtn.style.marginTop = '0';
              fsBtn.style.padding = '0.5rem';
              fsBtn.style.background = 'rgba(0,0,0,0.5)';
              fsBtn.style.border = '1px solid rgba(255,255,255,0.15)';
              fsBtn.style.borderRadius = '0.5rem';
              fsBtn.style.opacity = '0.4';
              iconMax.innerHTML =
                '<path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"></path>';

              // Game fills the screen
              if (gameWrapper) {
                gameWrapper.style.maxWidth = '100vw';
                gameWrapper.style.maxHeight = '100vh';
                gameWrapper.style.width = '100vw';
                gameWrapper.style.height = '100vh';
                gameWrapper.style.aspectRatio = 'unset';
              }
              if (frameContainer) {
                frameContainer.style.borderRadius = '0';
                frameContainer.style.border = 'none';
                frameContainer.style.boxShadow = 'none';
              }
            } else {
              // Restore full button
              fsText.style.display = '';
              fsBtn.style.position = '';
              fsBtn.style.right = '';
              fsBtn.style.bottom = '';
              fsBtn.style.zIndex = '';
              fsBtn.style.marginTop = '';
              fsBtn.style.padding = '';
              fsBtn.style.background = '';
              fsBtn.style.border = '';
              fsBtn.style.borderRadius = '';
              fsBtn.style.opacity = '';
              fsText.textContent = 'FULLSCREEN';
              iconMax.innerHTML =
                '<path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>';

              // Restore game size
              if (gameWrapper) {
                gameWrapper.style.maxWidth = '';
                gameWrapper.style.maxHeight = '';
                gameWrapper.style.width = '';
                gameWrapper.style.height = '';
                gameWrapper.style.aspectRatio = '';
              }
              if (frameContainer) {
                frameContainer.style.borderRadius = '';
                frameContainer.style.border = '';
                frameContainer.style.boxShadow = '';
              }
            }
          }
        },
        { signal: controller.signal }
      );

      // Hover effect for compact fullscreen button
      fsBtn.addEventListener('mouseenter', () => {
        if (document.fullscreenElement) {
          fsBtn.style.opacity = '1';
          fsBtn.style.background = 'rgba(0,0,0,0.8)';
        }
      });
      fsBtn.addEventListener('mouseleave', () => {
        if (document.fullscreenElement) {
          fsBtn.style.opacity = '0.4';
          fsBtn.style.background = 'rgba(0,0,0,0.5)';
        }
      });
    }

    // ===== PUSH SIDEBAR ADS =====
    try {
      const w = window as unknown as Record<string, unknown>;
      const ads = (w.adsbygoogle as unknown[]) || [];
      w.adsbygoogle = ads;
      ads.push({});
      ads.push({});
    } catch (e) {
      console.log('[ADS] Sidebar push error:', e);
    }
  });

  // ===== IFRAME MESSAGE HANDLER =====
  window.addEventListener('message', (event) => {
    // Lemon Squeezy checkout
    if (event.data && event.data.type === 'LEMON_SQUEEZY_CHECKOUT') {
      console.log('[ASTRO] Opening Lemon Squeezy in a new tab...');
      window.open(event.data.url, '_blank');
    }
    // Generic link opening (privacy, terms, etc.)
    if (event.data && event.data.type === 'OPEN_LINK') {
      console.log('[ASTRO] Opening link in new tab:', event.data.url);
      window.open(event.data.url, '_blank');
    }
    // Payment success relay
    if (event.data === 'payment_success') {
      console.log('[ASTRO] Payment success received! Telling Godot...');
      const gameIframe = document.getElementById('game-iframe') as HTMLIFrameElement;
      if (gameIframe && gameIframe.contentWindow) {
        gameIframe.contentWindow.postMessage('payment_success', '*');
      }
    }
    // Premium user — hide sidebar ads
    if (event.data === 'premium_active') {
      console.log('[ASTRO] Premium detected, hiding sidebar ads');
      const leftAd = document.getElementById('sidebar-ad-left');
      const rightAd = document.getElementById('sidebar-ad-right');
      if (leftAd) leftAd.style.display = 'none';
      if (rightAd) rightAd.style.display = 'none';
    }
    // OAuth success relay — callback tab sends tokens to this parent window
    if (event.data && event.data.type === 'OAUTH_SUCCESS') {
      console.log('[ASTRO] OAuth tokens received, forwarding to Godot...');
      const gameIframe = document.getElementById('game-iframe') as HTMLIFrameElement;
      if (gameIframe && gameIframe.contentWindow) {
        gameIframe.contentWindow.postMessage(
          {
            type: 'OAUTH_SUCCESS',
            access_token: event.data.access_token,
            refresh_token: event.data.refresh_token,
          },
          '*'
        );
      }
    }
  });

  // Pickup sessionStorage fallback (when callback couldn't reach opener and redirected home)
  (function () {
    try {
      const url = new URL(window.location.href);
      if (url.searchParams.get('oauth') === 'pending') {
        const stored = sessionStorage.getItem('sc_oauth_tokens');
        if (stored) {
          const payload = JSON.parse(stored);
          sessionStorage.removeItem('sc_oauth_tokens');
          // Wait for iframe to be ready, then post
          const deliver = () => {
            const gameIframe = document.getElementById('game-iframe') as HTMLIFrameElement;
            if (gameIframe && gameIframe.contentWindow) {
              gameIframe.contentWindow.postMessage(
                {
                  type: 'OAUTH_SUCCESS',
                  access_token: payload.access_token,
                  refresh_token: payload.refresh_token,
                },
                '*'
              );
              // Clean the URL
              url.searchParams.delete('oauth');
              window.history.replaceState({}, '', url.pathname);
            }
          };
          // Wait a moment for the iframe to load up
          setTimeout(deliver, 2000);
        }
      }
    } catch (e) {
      console.error('[ASTRO] OAuth pickup error:', e);
    }
  })();
</script>

