---
import Layout from '~/layouts/Layout.astro';
---

<Layout
  metadata={{
    // The layout appends '| Skill Check', so the brand belongs there and not here,
    // or every page reads 'Skill Check ... | Skill Check'. Nobody searches the brand
    // yet either, so the words people DO search lead.
    title: 'Free Daily Gaming Trivia Card Game',
    description:
      'Test your gaming knowledge in a free daily trivia card game. No account needed. Collect illustrated cards, discover combos, and unlock past daily themes from £1.',
  }}
>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap');

    :root {
      --bg-deep: #050508;
      --bg-surface: #0a0a0c;
      --bg-card: #151518;
      --border: #2a2a35;
      --text-main: #ffffff;
      --text-dim: #888899;
      --accent: #00e5ff;
      --accent-glow: rgba(0, 229, 255, 0.15);
      --warning: #ffcc00;
      --success: #00ff88;
      --danger: #ff4466;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: 'Outfit', sans-serif;
      background: var(--bg-deep);
      color: var(--text-main);
      margin: 0;
      overflow-x: hidden;
    }

    /* ===== HERO / GAME SECTION ===== */
    .hero-section {
      position: relative;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
      background:
        radial-gradient(ellipse at 50% 0%, rgba(0, 229, 255, 0.06) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 80%, rgba(255, 204, 0, 0.04) 0%, transparent 50%), var(--bg-deep);
    }

    /* Keep the offer and instructions accessible on phones too. */
    .site-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      max-width: 1100px;
      margin: auto;
      padding: 1.25rem 1.5rem;
    }
    .brand {
      font:
        700 1rem 'JetBrains Mono',
        monospace;
      color: var(--accent);
      text-decoration: none;
    }
    .site-nav nav {
      display: flex;
      gap: 1.25rem;
      font-size: 0.85rem;
    }
    .site-nav nav a {
      color: var(--text-main);
      text-decoration: none;
    }
    .site-nav nav a:hover {
      color: var(--accent);
    }
    .intro-hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 2rem;
      max-width: 1100px;
      margin: auto;
      padding: 3rem 1.5rem 4rem;
    }
    .eyebrow {
      font:
        700 0.75rem 'JetBrains Mono',
        monospace;
      color: var(--success);
      letter-spacing: 0.08em;
      margin-bottom: 1rem;
    }
    .intro-hero h1 {
      font-size: clamp(2.4rem, 4.3vw, 3.8rem);
      font-weight: 800;
      line-height: 1.08;
      letter-spacing: -0.04em;
      margin: 0 0 1.25rem;
    }
    .intro-hero h1 span {
      color: var(--accent);
    }
    .hero-description {
      color: #b5b5c5;
      font-size: 1.1rem;
      line-height: 1.7;
      margin: 0 0 1.5rem;
      max-width: 32rem;
    }
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem;
    }
    .secondary-link {
      color: var(--text-main);
      text-underline-offset: 5px;
    }
    .reassurance {
      color: #a6a6b8;
      font-size: 0.85rem;
      margin-top: 1rem;
    }
    .card-preview {
      width: 100%;
      height: auto;
      border: 1px solid var(--border);
      border-radius: 1rem;
      box-shadow: 0 20px 70px #00e5ff0a;
    }
    .game-intro {
      text-align: center;
      margin-bottom: 1.5rem;
    }
    .game-intro h2 {
      font-size: 1.6rem;
      font-weight: 700;
      margin: 0 0 0.5rem;
    }
    .game-intro p {
      color: #a6a6b8;
      margin: 0;
    }
    .game-tools {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 1rem;
    }
    .direct-play {
      color: #b5b5c5;
      font-size: 0.85rem;
      padding-top: 0.75rem;
      text-underline-offset: 4px;
    }
    #game-container,
    #supporter,
    #how-to-play {
      scroll-margin-top: 1rem;
    }
    .supporter-section {
      padding: 2rem 0;
    }
    .supporter-section h2 {
      text-align: center;
      font-size: 2rem;
      font-weight: 800;
      margin: 0 0 0.75rem;
    }
    .supporter-intro {
      text-align: center;
      color: #b5b5c5;
      line-height: 1.7;
      margin: 0 auto 1.75rem;
      max-width: 36rem;
    }
    .plans {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .plan {
      padding: 1.75rem;
      border: 1px solid var(--border);
      border-radius: 1rem;
      background: var(--bg-card);
    }
    .plan-paid {
      border-color: #ffcc0066;
      background: linear-gradient(145deg, #272216, var(--bg-card) 65%);
    }
    .plan h3 {
      font-size: 1.15rem;
      font-weight: 700;
      margin: 0 0 1rem;
    }
    .plan-price {
      font-size: 2rem;
      font-weight: 800;
      margin: 0;
    }
    .plan-price span {
      font-size: 0.85rem;
      color: #b5b5c5;
      font-weight: 400;
    }
    .plan ul {
      padding-left: 1.1rem;
      list-style: disc;
      color: #c4c4d0;
      line-height: 1.7;
      margin: 1.25rem 0;
    }
    .plan li {
      margin-bottom: 0.45rem;
    }
    .plan .cta-btn {
      display: block;
      padding: 0.9rem 1rem;
      text-align: center;
      font-size: 0.8rem;
    }
    .plan-paid .cta-btn {
      background: var(--warning);
    }
    .plan-note {
      color: #b5b5c5;
      font-size: 0.8rem;
      line-height: 1.6;
      margin: 0.85rem 0 0;
    }
    .supporter-section details {
      border-bottom: 1px solid var(--border);
      padding: 1rem 0;
    }
    .supporter-section summary {
      cursor: pointer;
      font-weight: 600;
    }
    .supporter-section details p {
      color: #b5b5c5;
      line-height: 1.7;
      margin-top: 0.75rem;
    }
    a:focus-visible,
    button:focus-visible,
    summary:focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 5px;
    }
    @media (max-width: 767px) {
      .intro-hero {
        grid-template-columns: 1fr;
        gap: 1.5rem;
        padding-top: 1.5rem;
        padding-bottom: 2rem;
      }
      .hero-actions .cta-btn {
        width: 100%;
        text-align: center;
      }
      .hero-section {
        min-height: auto;
        padding: 1.5rem 0.75rem;
      }
      .game-wrapper {
        width: min(100%, 420px);
        height: auto;
        max-height: none;
        aspect-ratio: 9 / 16;
      }
      .game-column {
        width: 100%;
      }
      .game-row {
        gap: 0;
      }
      .plans {
        grid-template-columns: 1fr;
      }
      .stats-bar {
        gap: 1rem;
        flex-wrap: wrap;
      }
      .site-nav {
        padding: 1rem;
      }
      .site-nav nav {
        gap: 0.75rem;
        font-size: 0.75rem;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation: none !important;
        transition: none !important;
      }
    }

    /* ===== GAME ROW WITH SIDEBAR ADS ===== */
    .game-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      width: 100%;
      max-width: 1200px;
    }

    .sidebar-ad {
      display: none;
      width: 160px;
      min-height: 600px;
      flex-shrink: 0;
    }

    /* Only show sidebars when there's enough room either side */
    @media (min-width: 1100px) {
      .sidebar-ad {
        display: block;
      }
    }

    /* Hide sidebars in fullscreen */
    :fullscreen .sidebar-ad,
    :-webkit-full-screen .sidebar-ad {
      display: none !important;
    }

    /* Game column — wraps game + fullscreen button vertically */
    .game-column {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* Game iframe container - Strict 9:16, Max Height */
    .game-wrapper {
      position: relative;
      /* Instead of forcing width, we force the height to fill the screen */
      height: 78vh;
      max-height: 900px;
      /* The width will automatically calculate based on the height */
      aspect-ratio: 9 / 16;
      margin: 0 auto;
    }

    @media (max-width: 767px) {
      .game-wrapper {
        width: min(100%, 420px);
        height: auto;
        max-height: none;
        aspect-ratio: 9 / 16;
      }
    }

    .game-frame-container {
      width: 100%;
      height: 100%;
      background: var(--bg-surface);
      border-radius: 1rem;
      overflow: hidden;
      border: 1px solid var(--border);
      box-shadow:
        0 0 80px rgba(0, 0, 0, 0.8),
        0 0 40px rgba(0, 229, 255, 0.05);
    }

    .game-frame-container iframe {
      width: 100%;
      height: 100%;
      border: none;
      outline: none;
    }

    /* Fullscreen button — sits below the game frame */
    .fullscreen-btn {
      display: none;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.25rem;
      margin-top: 0.75rem;
      background: rgba(21, 21, 24, 0.85);
      color: var(--text-main);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      cursor: pointer;
      font-family: 'Outfit', sans-serif;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      transition:
        opacity 0.2s ease,
        background 0.2s ease;
      backdrop-filter: blur(8px);
      z-index: 10;
    }

    .fullscreen-btn:hover {
      background: var(--accent);
      color: var(--bg-deep);
      border-color: var(--accent);
    }

    @media (min-width: 768px) {
      .fullscreen-btn {
        display: flex;
      }
    }

    /* ===== BELOW THE FOLD ===== */
    .below-fold {
      background: var(--bg-deep);
      padding: 0 1.5rem 4rem;
    }

    .content-column {
      max-width: 720px;
      margin: 0 auto;
    }

    /* Section divider */
    .section-divider {
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--border), transparent);
      margin: 3rem 0;
    }

    /* What is Skill Check */
    .intro-section {
      text-align: center;
      padding: 2rem 0;
    }

    .intro-section h2 {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--warning);
      margin: 0 0 1rem;
    }

    .intro-section p {
      font-size: 1.05rem;
      line-height: 1.8;
      color: var(--text-dim);
      max-width: 560px;
      margin: 0 auto;
    }

    /* Feature cards */
    .features-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin: 2rem 0;
    }

    @media (max-width: 500px) {
      .features-grid {
        grid-template-columns: 1fr;
      }
    }

    .feature-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 1rem;
      padding: 1.5rem;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .feature-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--accent), transparent);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .feature-card:hover::before {
      opacity: 1;
    }
    .feature-card:hover {
      border-color: rgba(0, 229, 255, 0.3);
      transform: translateY(-2px);
    }

    .feature-icon {
      font-size: 1.8rem;
      margin-bottom: 0.75rem;
      display: block;
    }

    .feature-card h3 {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-main);
      margin: 0 0 0.5rem;
      letter-spacing: 0.02em;
    }

    .feature-card p {
      font-size: 0.88rem;
      line-height: 1.6;
      color: var(--text-dim);
      margin: 0;
    }

    /* How to play */
    .howto-section h2 {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--accent);
      text-align: center;
      margin: 0 0 2rem;
    }

    .howto-steps {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .howto-step {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.25rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
    }

    .step-number {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.5rem;
      font-weight: 900;
      color: var(--accent);
      min-width: 2.5rem;
      text-align: center;
      line-height: 1;
      padding-top: 0.15rem;
    }

    .step-text h4 {
      font-weight: 700;
      font-size: 1rem;
      margin: 0 0 0.25rem;
      color: var(--text-main);
    }

    .step-text p {
      font-size: 0.88rem;
      color: var(--text-dim);
      margin: 0;
      line-height: 1.5;
    }

    /* Stats bar */
    .stats-bar {
      display: flex;
      justify-content: center;
      gap: 2.5rem;
      padding: 2rem 0;
      text-align: center;
    }

    .stat-item .stat-value {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--warning);
      display: block;
    }

    .stat-item .stat-label {
      font-size: 0.8rem;
      color: var(--text-dim);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    /* CTA */
    .cta-section {
      text-align: center;
      padding: 2rem 0;
    }

    .cta-section p {
      color: var(--text-dim);
      font-size: 1rem;
      margin: 0 0 1.5rem;
    }

    .cta-btn {
      display: inline-block;
      padding: 1rem 2.5rem;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      font-size: 1rem;
      letter-spacing: 0.05em;
      color: var(--bg-deep);
      background: var(--accent);
      border: none;
      border-radius: 0.75rem;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
    }

    .cta-btn:hover {
      background: var(--warning);
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(255, 204, 0, 0.2);
    }

    /* Footer */
    .site-footer {
      background: var(--bg-surface);
      border-top: 1px solid var(--border);
      padding: 2rem 1.5rem;
      text-align: center;
    }

    .footer-links {
      display: flex;
      justify-content: center;
      gap: 2rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }

    .footer-links a {
      color: var(--text-dim);
      text-decoration: none;
      font-size: 0.85rem;
      transition: color 0.2s;
    }

    .footer-links a:hover {
      color: var(--accent);
    }

    .footer-copy {
      color: var(--text-dim);
      font-size: 0.78rem;
      opacity: 0.6;
    }

    /* Animations */
    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <header class="site-nav">
    <a class="brand" href="/">SKILL CHECK</a>
    <nav aria-label="Main navigation">
      <a href="#how-to-play">How to play</a>
      <a href="#supporter">Unlock the archive</a>
    </nav>
  </header>

  <section class="intro-hero" aria-labelledby="hero-heading">
    <div>
      <p class="eyebrow">FREE DAILY GAMING TRIVIA</p>
      <h1 id="hero-heading">Know your games?<br /><span>Put it to the test.</span></h1>
      <p class="hero-description">
        Build a hand of gaming icons. Combine their cards for bonuses. Answer trivia to beat today's challenge — then
        come back for a new theme tomorrow.
      </p>
      <div class="hero-actions">
        <a href="#game-container" class="cta-btn" data-funnel="play_free">PLAY FREE</a>
        <a href="#supporter" class="secondary-link" data-funnel="view_upgrade">More to play? From £1 →</a>
      </div>
      <p class="reassurance">No download. No account needed to play.</p>
    </div>
    <img
      class="card-preview"
      src="/images/og-card.png"
      width="1200"
      height="630"
      alt="Illustrated Skill Check cards featuring Master Chief, Pikachu, Steve, Tom Nook and Doom Slayer"
      fetchpriority="high"
    />
  </section>

  <section class="hero-section" aria-label="Play Skill Check">
    <div class="game-intro">
      <h2>Your free daily challenge</h2>
      <p>Same cards. Same questions. How far can you get?</p>
    </div>

    <!-- Game row: sidebar ad | game | sidebar ad -->
    <div class="game-row">
      <!-- LEFT SIDEBAR AD (desktop only, 1100px+) -->
      <div class="sidebar-ad sidebar-ad-left" id="sidebar-ad-left">
        <ins
          class="adsbygoogle"
          style="display:block"
          data-ad-client="ca-pub-5073150196607526"
          data-ad-slot="8746534572"
          data-ad-format="vertical"
          data-full-width-responsive="false"
        >
        </ins>
      </div>

      <!-- GAME + FULLSCREEN BUTTON -->
      <div class="game-column">
        <div id="game-container" class="game-wrapper">
          <div class="game-frame-container">
            <iframe
              id="game-iframe"
              title="Skill Check — free daily trivia game"
              loading="lazy"
              src="/play/index.html?v=4"
              allow="autoplay; fullscreen; clipboard-read; clipboard-write; payment; web-share"
              sandbox="allow-forms allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-top-navigation-by-user-activation allow-downloads"
              allowfullscreen></iframe>
          </div>
        </div>

        <div class="game-tools">
          <a class="direct-play" href="/play/?v=4" data-astro-reload data-funnel="open_game"
            >Open game in full window ↗</a
          >
          <button id="fullscreen-btn" class="fullscreen-btn" title="Toggle Fullscreen">
            <svg
              id="icon-max"
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
              ></path>
            </svg>
            <span id="fullscreen-text">FULLSCREEN</span>
          </button>
        </div>
      </div>

      <!-- RIGHT SIDEBAR AD (desktop only, 1100px+) -->
      <div class="sidebar-ad sidebar-ad-right" id="sidebar-ad-right">
        <ins
          class="adsbygoogle"
          style="display:block"
          data-ad-client="ca-pub-5073150196607526"
          data-ad-slot="8746534572"
          data-ad-format="vertical"
          data-full-width-responsive="false"
        >
        </ins>
      </div>
    </div>
  </section>

  <!-- Instructions and upgrade details remain available at every screen size. -->
  <div class="below-fold">
    <div class="content-column">
      <div class="section-divider"></div>

      <section class="supporter-section" id="supporter" aria-labelledby="supporter-heading">
        <h2 id="supporter-heading">Your favourite theme. On your schedule.</h2>
        <p class="supporter-intro">
          The daily challenge is free. Upgrade when you want to explore past themes, replay your favourites, and play
          without ads.
        </p>
        <div class="plans">
          <article class="plan">
            <h3>Daily player</h3>
            <p class="plan-price">Free <span>every day</span></p>
            <ul>
              <li>A new themed daily challenge</li>
              <li>Collect cards and discover synergies</li>
              <li>Three practice replays after your daily</li>
              <li>Optional free account for leaderboards and progress sync</li>
            </ul>
            <a href="#game-container" class="cta-btn" data-funnel="play_free">PLAY TODAY'S DAILY</a>
            <p class="plan-note">
              Start playing as a guest. Sign up when you want to keep your progress across devices.
            </p>
          </article>
          <article class="plan plan-paid">
            <h3>Archive + Supporter</h3>
            <p class="plan-price">From £1 <span>one time</span></p>
            <ul>
              <li>Play past daily themes on demand</li>
              <li>Unlimited daily replays</li>
              <li>Remove ads</li>
              <li>Supporter badge and monthly theme suggestions</li>
            </ul>
            <a href="#game-container" class="cta-btn" data-funnel="upgrade_interest">OPEN GAME TO UPGRADE</a>
            <p class="plan-note">
              Choose <strong>Unlock Archive</strong> in the game. Sign in to link your purchase. Pay what you want: £1 minimum,
              £5 suggested. No subscription.
            </p>
          </article>
        </div>
        <details>
          <summary>Do I need to pay or create an account to try it?</summary>
          <p>
            No. Play today's daily challenge as a guest. A free account lets you post scores and sync your progress; the
            archive upgrade is optional.
          </p>
        </details>
        <details>
          <summary>What if today's theme isn't my thing?</summary>
          <p>
            A different theme arrives at midnight UTC. The archive lets supporters browse and play past themes whenever
            they like.
          </p>
        </details>
        <details>
          <summary>How do I keep my progress?</summary>
          <p>
            Sign in with Google, Discord, or an email code. Use the same account when you return or switch devices, and
            use that account's email at checkout.
          </p>
        </details>
      </section>
      <div class="section-divider"></div>

      <!-- INTRO -->
      <section class="intro-section">
        <h2>WHAT IS SKILL CHECK?</h2>
        <p>
