---
import Layout from '~/layouts/Layout.astro';
---

<Layout metadata={{ title: 'Skill Check - Play Now' }}>
  <!-- Hosted locally to bypass COEP/CORP issues -->

  <main
    class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-[#050508] md:relative md:min-h-screen md:z-auto md:py-8 overflow-hidden md:overflow-auto"
  >
    <div id="game-container" class="relative w-full h-full md:h-[85vh] md:max-w-[450px] mx-auto shrink-0">
      <div
        class="w-full h-full bg-[#0a0a0c] md:rounded-2xl overflow-hidden shadow-[0_0_40px_rgba(0,0,0,0.8)] border border-transparent md:border-[#2a2a35]"
      >
        <iframe
          id="game-iframe"
          src="/play/index.html?v=4"
          class="w-full h-full border-none focus:outline-none"
          allow="autoplay; fullscreen; clipboard-read; clipboard-write; payment"
          sandbox="allow-forms allow-scripts allow-same-origin allow-popups allow-top-navigation-by-user-activation"
          allowfullscreen
        >
        </iframe>
      </div>

      <button
        id="fullscreen-btn"
        class="absolute -right-40 bottom-0 z-50 px-4 py-3 bg-[#151518] hover:bg-cyan-600 text-white rounded-xl transition-all duration-300 hidden md:flex items-center gap-2 border border-[#2a2a35] shadow-lg"
        title="Toggle Fullscreen"
      >
        <svg
          id="icon-max"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
          ></path>
        </svg>
        <span id="fullscreen-text" class="text-sm font-bold tracking-wider">FULLSCREEN</span>
      </button>
    </div>
  </main>
</Layout>

<script>
  window.addEventListener('message', (event) => {
    // 1. RELAY: Godot asked us to open the checkout
    if (event.data && event.data.type === 'LEMON_SQUEEZY_CHECKOUT') {
      console.log('[ASTRO] Opening Lemon Squeezy in a new tab...');

      // Force a native new tab. No overlay!
      window.open(event.data.url, '_blank');
    }

    // 2. RELAY: The success.html page in the new tab just pinged us!
    if (event.data === 'payment_success') {
      console.log('[ASTRO] Payment success received from new tab! Telling Godot...');

      // Pass the message down into the Godot iframe
      const gameIframe = document.getElementById('game-iframe') as HTMLIFrameElement;
      if (gameIframe?.contentWindow) {
        gameIframe.contentWindow.postMessage('payment_success', '*');
      }
    }
  });
</script>
