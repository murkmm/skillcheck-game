---
import Layout from '~/layouts/Layout.astro';
---

<Layout metadata={{ title: 'Skill Check - Play Now' }}>
  <!-- 1. Hosted locally to bypass COEP/CORP issues -->
  <script is:inline src="/lemon.js" defer></script>

  <main
    class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-[#050508] md:relative md:min-h-screen md:z-auto md:py-8 overflow-hidden md:overflow-auto"
  >
    <div id="game-container" class="relative w-full h-full md:h-[85vh] md:max-w-[450px] mx-auto shrink-0">
      <div
        class="w-full h-full bg-[#0a0a0c] md:rounded-2xl overflow-hidden shadow-[0_0_40px_rgba(0,0,0,0.8)] border border-transparent md:border-[#2a2a35]"
      >
        <iframe
          src="/play/index.html?v=4"
          class="w-full h-full border-none focus:outline-none"
          allow="autoplay; fullscreen; clipboard-read; clipboard-write; payment"
          sandbox="allow-forms allow-scripts allow-same-origin allow-popups allow-top-navigation-by-user-activation"
          allowfullscreen
        >
        </iframe>
      </div>

      <button
        id="fullscreen-btn"
        class="absolute -right-40 bottom-0 z-50 px-4 py-3 bg-[#151518] hover:bg-cyan-600 text-white rounded-xl transition-all duration-300 hidden md:flex items-center gap-2 border border-[#2a2a35] shadow-lg"
        title="Toggle Fullscreen"
      >
        <svg
          id="icon-max"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
          ></path>
        </svg>
        <svg
          id="icon-min"
          class="hidden"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"
          ></path>
        </svg>
        <span id="fullscreen-text" class="text-sm font-bold tracking-wider">FULLSCREEN</span>
      </button>
    </div>

    <div class="hidden md:flex md:static md:flex-wrap justify-center gap-6 text-sm text-slate-500 mt-6 shrink-0">
      <a href="/terms" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition">Terms of Use</a>
      <a href="/privacy" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition"
        >Privacy Policy</a
      >
      <a href="/refunds" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition"
        >Refund Policy</a
      >
      <a href="mailto:support@ki10games.com" class="hover:text-cyan-400 transition">Contact Support</a>
    </div>
  </main>
</Layout>

<script>
  // Handle Service Worker
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.getRegistrations().then((registrations) => {
      for (const registration of registrations) {
        registration.unregister();
      }
    });
  }

  // Fullscreen logic
  const btn = document.getElementById('fullscreen-btn');
  const container = document.getElementById('game-container');
  if (btn && container) {
    btn.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        container.requestFullscreen();
      } else {
        document.exitFullscreen();
      }
    });
  }

  // Note: We no longer need the LemonSqueezy listener here
  // because Godot is forcing the top window to navigate directly.
</script>
