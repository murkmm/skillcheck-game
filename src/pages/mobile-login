<!DOCTYPE html>
<html>
<head>
    <title>Login Successful</title>
    <style>
        body { background-color: #0a0a0c; color: white; font-family: sans-serif; text-align: center; padding-top: 50px; }
        .btn { background-color: #00ffff; color: black; padding: 15px 30px; text-decoration: none; border-radius: 10px; font-weight: bold; font-size: 20px; display: inline-block; margin-top: 20px; }
    </style>
</head>
<body>
    <h2>Authentication Successful!</h2>
    <p>Redirecting you back to the game...</p>
    
    <a id="returnBtn" href="#" class="btn">Return to Game</a>

    <script>
        // 1. Grab the Supabase tokens from the URL
        const tokens = window.location.hash; 
        
        // 2. Build the deep link
        const deepLink = "skillcheck://auth/callback" + tokens;
        
        // 3. Attach it to the button
        document.getElementById("returnBtn").href = deepLink;
        
        // 4. Try to automatically push them to the app
        window.location.replace(deepLink);
    </script>
</body>
</html>