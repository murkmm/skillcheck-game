---
import Layout from '~/layouts/Layout.astro';
---

<Layout
  metadata={{
    title: 'Login Successful - Skill Check',
    description: 'Redirecting back to the app...',
  }}
>
  <style>
    .trampoline-container {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
      background: var(--bg-deep);
    }
    h2 {
      font-family: 'JetBrains Mono', monospace;
      font-size: 2rem;
      font-weight: 800;
      color: var(--success);
      margin-bottom: 1rem;
    }
    p {
      color: var(--text-dim);
      font-size: 1.1rem;
      margin-bottom: 2rem;
    }
    .btn {
      display: inline-block;
      padding: 1rem 2.5rem;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      font-size: 1rem;
      letter-spacing: 0.05em;
      color: var(--bg-deep);
      background: var(--accent);
      border: none;
      border-radius: 0.75rem;
      text-decoration: none;
      transition: all 0.3s ease;
    }
    .btn:hover {
      background: var(--warning);
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(255, 204, 0, 0.2);
    }
  </style>

  <div class="trampoline-container">
    <h2>AUTHENTICATION SUCCESSFUL</h2>
    <p>Redirecting you back to the game...</p>

    <a id="returnBtn" href="#" class="btn">RETURN TO GAME</a>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Grab the Supabase tokens (starts with '#')
      const tokens = window.location.hash;

      // 2. Standard link for iOS/Desktop uses the '#'
      const standardLink = 'skillcheck://auth/callback' + tokens;

      // 3. Android Intent FIX: Change the '#' to a '?' so it doesn't break the Intent parsing!
      const safeTokens = tokens.replace('#', '?');
      const packageName = 'com.ki10games.skillcheck';
      const intentLink =
        'intent://auth/callback' + safeTokens + '#Intent;scheme=skillcheck;package=' + packageName + ';end;';

      // 4. Route based on device
      const isAndroid = /Android/i.test(navigator.userAgent);
      const finalLink = isAndroid ? intentLink : standardLink;

      // 5. Attach & Auto-Push
      const returnBtn = document.getElementById('returnBtn') as HTMLAnchorElement | null;
      if (returnBtn) {
        returnBtn.href = finalLink;
      }

      setTimeout(() => {
        window.location.replace(finalLink);
      }, 500);
    });
  </script>
</Layout>
